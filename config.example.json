{
  "runs_cold": 5,
  "runs_warm": 5,
  "prompt": "Reply with the single word: pong",
  "max_tokens": 16,
  "gateways": [
    {
      "name": "vercel",
      "host": "ai-gateway.vercel.sh",
      "path": "/v1/chat/completions",
      "model": "anthropic/claude-haiku-4.5",
      "auth_value": "Bearer $AI_GATEWAY_API_KEY"
    },
    {
      "name": "openrouter",
      "host": "openrouter.ai",
      "path": "/api/v1/chat/completions",
      "model": "anthropic/claude-haiku-4.5",
      "auth_value": "Bearer $OPENROUTER_API_KEY"
    },
    {
      "name": "cloudflare",
      "host": "api.cloudflare.com",
      "path": "/client/v4/accounts/$CLOUDFLARE_ACCOUNT_ID/ai/v1/messages",
      "model": "anthropic/claude-haiku-4.5",
      "auth_value": "Bearer $CLOUDFLARE_API_TOKEN"
    }
  ]
}
